@echo off
chcp 65001 >nul
rem ─────────────────────────────────────────────────────────────────────────
rem  «Фотореал» в Blender — как OPEN_*.cmd в 3D_Cups, но сцены фотореальные.
rem  Откроется Blender, справа панель N → «Фотореал»:
rem    1. фон, ракурс, стакан, картон, макет, конгрев, имитация, качество —
rem       «Собрать сцену»: сцена откроется здесь, уже с настройками качества
rem    2. двигайте камеру и стаканы как угодно; макет, конгрев, имитацию —
rem       «Применить к сцене», без пересборки
rem    3. F12 (или «Рендер кадра») — кадр того, что в сцене: стакан резкий,
rem       фон размыт, «камера»; кадр — в D:\Cups_Soft\Рендеры\<дата>
rem ─────────────────────────────────────────────────────────────────────────
set "BLENDER=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe"
if not exist "%BLENDER%" (
  echo  Не найден Blender 5.2: %BLENDER%
  pause
  exit /b 1
)
start "" "%BLENDER%" --python "%~dp0render\engine\studio_panel.py"
