# Зависимости сборки. В репозиторий не попадают: собранный файл лежит в dist/
# и коммитится, поэтому сайт работает и без установки Node.
node_modules/

# Служебные каталоги редакторов и IDE
.vs/
.vscode/
.idea/
.claude/
*.suo
*.user
*.sln.docstates

# Операционные системы
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Логи и временные файлы
*.log
npm-debug.log*
*.tmp
*.bak
~$*

# Локальные настройки окружения
.env
.env.local

# Generated local capture verification page and its media
capture-review.local.html
tests/output/

# render:check — сборка страницы съёмки и результаты прогона
tests/render/.build/
tests/render/out/

# Локальные клиентские ссылки dev-сервера (scripts/snapshotApi.mjs)
.local-snapshots/

# render/ — движок рендера (бывший 3DCupRender). Тяжёлые файлы Blender, текстуры
# и тестовые макеты в git не кладутся: их список с размерами и хешами —
# render/assets.json (python render/engine/tools/assets.py check).
render/scenes/
render/art/
render/cups/**/*.blend
render/cups/**/*.blend1
render/cups/**/*.glb
render/cups/**/*.obj
render/cups/**/*.mtl
render/cups/**/*.png
render/cups/**/*.jpg
render/cups/**/*.pdf
render/cups/**/textures/
render/cups/plastic/library/
# выгрузки для превью и кадры — пересобираются инструментами
render/web/scenes/
render/web/cups/
render/out/*
!render/out/preview_check/
render/out/preview_check/*
!render/out/preview_check/jobs/
__pycache__/
*.pyc
*.blend1
tests/photoreal/out/
